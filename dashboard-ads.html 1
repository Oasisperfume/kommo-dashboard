}

function renderCTRList(){
  let rows=S.metaData.filter(r=>{
    if(S.ctrSeg&&r.segment!==S.ctrSeg)return false;
    if(S.ctrPais&&(r.country||r.country_iso)!==S.ctrPais)return false;
    if(!(+r.ctr>0))return false;
    return true;
  });
  rows.sort((a,b)=>(+b.ctr||0)-(+a.ctr||0));
  rows=rows.slice(0,20);
  const maxCTR=rows.length>0?(+rows[0].ctr||0):1;
  const el=$('ctr-list');
  if(!rows.length){el.innerHTML='<div class="empty"><div class="empty-icon">📊</div><div class="empty-txt">Sin datos</div></div>';return;}
  el.innerHTML=rows.map((r,i)=>{
    const ctr=+r.ctr||0;
    const pct=maxCTR>0?(ctr/maxCTR)*100:0;
    const name=r.campaign_name.length>50?r.campaign_name.substring(0,50)+'…':r.campaign_name;
    return`<div class="ctr-bar-row">
      <span class="ctr-rank">#${i+1}</span>
      <span class="ctr-name" title="${r.campaign_name}">${name}</span>
      <div class="ctr-bar-wrap"><div class="ctr-bar-fill" style="width:${pct}%"></div></div>
      <span class="ctr-pct">${fmtPct(ctr)}</span>
      <span class="ctr-country">${r.country||r.country_iso||'—'}</span>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════
// TIKTOK MANUAL
// ═══════════════════════════════════════════════════════════════
async function saveTiktok(){
  const btn=$('btn-tt-save');
  const dateStart=$('tt-date-start').value;
  const dateStop=$('tt-date-stop').value;
  const country=$('tt-country').value;
  const spend=$('tt-spend').value;
  if(!dateStart||!dateStop||!country||!spend){showToast('❌ Completá los campos obligatorios (*)','err');return;}
  btn.disabled=true;btn.textContent='⏳ Guardando...';
  try{
    await sbPost('tiktok_ads_manual',{
      date_start:dateStart,
      date_stop:dateStop,
      campaign_name:$('tt-campaign').value||null,
      country,
      segment:$('tt-segment').value||null,
      spend:parseFloat(spend)||0,
      impressions:parseInt($('tt-impressions').value)||null,
      clicks:parseInt($('tt-clicks').value)||null,
      reach:parseInt($('tt-reach').value)||null,
      result_count:parseInt($('tt-results').value)||null,
      purchases:parseInt($('tt-purchases').value)||null,
      purchase_value:parseFloat($('tt-purchase-value').value)||null,
      notes:$('tt-notes').value||null,
      created_by:'dashboard'
    });
    showToast('✅ Registro TikTok guardado','ok');
    // Reset form
    ['tt-date-start','tt-date-stop','tt-campaign','tt-spend','tt-impressions','tt-clicks',
     'tt-reach','tt-results','tt-purchases','tt-purchase-value','tt-notes'].forEach(id=>{$(id).value='';});
    $('tt-country').value='';$('tt-segment').value='';
    // Reload tiktok data
    S.tiktokData=await sbGet(`tiktok_ads_manual?order=created_at.desc&limit=200`);
    renderTiktokHistory();
  }catch(e){
    showToast('❌ Error al guardar: '+e.message,'err');
  }
  btn.disabled=false;btn.textContent='✅ Guardar registro';
}

function renderTiktokHistory(){
  const rows=S.tiktokData;
  const tbody=$('tbody-tiktok');
  const empty=$('tt-empty');
  if(!rows.length){tbody.innerHTML='';empty.style.display='flex';return;}
  empty.style.display='none';
  tbody.innerHTML=rows.map(r=>`<tr>
    <td style="font-size:9px;">${r.date_start||'—'}</td>
    <td class="td-name" title="${r.campaign_name||''}">${r.campaign_name||'—'}</td>
    <td>${r.country||'—'}</td>
    <td class="td-num" style="color:var(--cyan);">${fmtM2(r.spend)}</td>
    <td class="td-num">${r.result_count||'—'}</td>
    <td class="td-num">${r.purchases||'—'}</td>
  </tr>`).join('');
}

// ═══════════════════════════════════════════════════════════════
// CHARTS
// ═══════════════════════════════════════════════════════════════
function dc(id){if(S.charts[id]){S.charts[id].destroy();delete S.charts[id];}}

function drawDoughnut(id,labels,data,colors){
  dc(id);
  const ctx=document.getElementById(id);
  if(!ctx)return;
  S.charts[id]=new Chart(ctx,{
    type:'doughnut',
    data:{labels,datasets:[{data,backgroundColor:colors.slice(0,labels.length),borderWidth:0,hoverOffset:4}]},
    options:{responsive:true,maintainAspectRatio:true,cutout:'65%',
      plugins:{legend:{position:'right',labels:{color:'rgba(240,240,248,0.6)',font:{family:'Montserrat',size:9},padding:8,boxWidth:10}},
        tooltip:{callbacks:{label:c=>`${c.label}: $${c.raw.toLocaleString('en-US')}`}}}}
  });
}

function drawBar(id,labels,data,color){
  dc(id);
  const ctx=document.getElementById(id);
  if(!ctx)return;
  S.charts[id]=new Chart(ctx,{
    type:'bar',
    data:{labels,datasets:[{data,backgroundColor:color+'cc',borderColor:color,borderWidth:1,borderRadius:4}]},
    options:{responsive:true,maintainAspectRatio:true,indexAxis:'y',
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>`$${c.raw.toLocaleString('en-US')}`}}},
      scales:{x:{ticks:{color:'rgba(240,240,248,0.4)',font:{size:8},callback:v=>`$${fmtN(v)}`},grid:{color:'rgba(255,255,255,0.05)'}},
              y:{ticks:{color:'rgba(240,240,248,0.6)',font:{size:8}},grid:{display:false}}}}
  });
}

// ═══════════════════════════════════════════════════════════════
// REFRESH META
// ═══════════════════════════════════════════════════════════════
async function refreshMeta(){
  const btn=$('btn-refresh-meta');
  btn.textContent='⏳ Sincronizando...';btn.disabled=true;
  try{
    await fetch(N8N_WEBHOOK,{method:'POST'});
    await new Promise(r=>setTimeout(r,4000));
    await loadData();
    renderAll();
    showToast('✅ Datos de Meta actualizados','ok');
  }catch(e){
    showToast('❌ Error al sincronizar','err');
  }
  btn.textContent='🔄 Sync Meta';btn.disabled=false;
}

// ═══════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════
function showToast(msg,type='ok'){
  const t=$('toast');
  t.textContent=msg;t.className=`toast ${type} show`;
  setTimeout(()=>t.classList.remove('show'),3000);
}

// ═══════════════════════════════════════════════════════════════
// RENDER ALL
// ═══════════════════════════════════════════════════════════════
function renderAll(){
  renderOverview();
  renderCampanas();
  renderConversion();
  renderTopCTR();
  renderTiktokHistory();
}

// ═══════════════════════════════════════════════════════════════
// EVENT LISTENERS
// ═══════════════════════════════════════════════════════════════
function setupEvents(){
  // Period pills
  document.querySelectorAll('#period-pills .pill').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('#period-pills .pill').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    S.period=b.dataset.p;
    $('loader').style.display='flex';
    loadData().then(()=>{renderAll();$('loader').style.display='none';});
  }));

  // Sub-tabs
  document.querySelectorAll('.stab').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('.stab').forEach(x=>x.classList.remove('on'));
    document.querySelectorAll('.tab-pane').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    $('tab-'+b.dataset.tab).classList.add('on');
  }));

  // Campañas segment filter
  document.querySelectorAll('#camp-filters .fpill[data-seg]').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('#camp-filters .fpill[data-seg]').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    S.campSeg=b.dataset.seg;
    renderCampanasTable();
  }));

  // Top CTR segment filter
  document.querySelectorAll('#ctr-filters .fpill[data-cseg]').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('#ctr-filters .fpill[data-cseg]').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    S.ctrSeg=b.dataset.cseg;
    renderCTRList();
  }));

  // Campañas table sort
  document.querySelectorAll('#tbl-campanas thead th[data-sort]').forEach(th=>{
    th.addEventListener('click',()=>{
      const col=th.dataset.sort;
      if(S.campSort.col===col){S.campSort.dir=S.campSort.dir==='desc'?'asc':'desc';}
      else{S.campSort={col,dir:'desc'};}
      renderCampanasTable();
    });
  });

  // Refresh Meta button
  $('btn-refresh-meta').addEventListener('click',refreshMeta);
}

// ═══════════════════════════════════════════════════════════════
// START
// ═══════════════════════════════════════════════════════════════
async function startApp(){
  $('loader').style.display='flex';
  $('app').style.display='none';
  try{
    await loadData();
    $('app').style.display='block';
    setupEvents();
    renderAll();
  }catch(e){
    console.error('Error cargando datos:',e);
    showToast('❌ Error cargando datos de Supabase','err');
    $('app').style.display='block';
  }finally{
    $('loader').style.display='none';
  }
}
</script>
