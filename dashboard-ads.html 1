  // Meta insights (latest view para campañas, raw para overview/ctr)
  const [metaRaw, tiktok, kommoIG, kommoTT, kommoOrd] = await Promise.all([
    sbGet(`meta_ads_insights?sync_date=gte.${from}&sync_date=lte.${to}&order=spend.desc&limit=1000`),
    sbGet(`tiktok_ads_manual?created_at=gte.${from}T00:00:00&order=created_at.desc&limit=200`),
    sbGet(`kommo_leads_eventos?etapa=eq.leads_entrantes&canal_adquisicion=eq.INSTAGRAM&counted_at=gte.${from}T00:00:00&counted_at=lte.${to}T23:59:59&select=lead_id,counted_at&limit=5000`),
    sbGet(`kommo_leads_eventos?etapa=eq.leads_entrantes&canal_adquisicion=eq.TIKTOK&counted_at=gte.${from}T00:00:00&counted_at=lte.${to}T23:59:59&select=lead_id,counted_at&limit=5000`),
    sbGet(`kommo_leads_eventos?etapa=eq.orden_recibida&presupuesto=gt.0&counted_at=gte.${from}T00:00:00&counted_at=lte.${to}T23:59:59&select=lead_id,presupuesto,canal_adquisicion,counted_at&limit=5000`)
  ]);

  S.metaData=metaRaw||[];
  S.tiktokData=tiktok||[];
  S.kommoLeadsIG=kommoIG||[];
  S.kommoLeadsTT=kommoTT||[];
  S.kommoOrdenes=kommoOrd||[];

  // Update sync time
  $('sync-txt').textContent=new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit',timeZone:'America/Bogota'});
}

