// ═══════════════════════════════════════════════════════════════
function renderOverview(){
  const data=S.metaData;
  const tt=S.tiktokData;
  const ordenes=S.kommoOrdenes;

  // Gasto Meta
  const totalSpend=data.reduce((a,r)=>a+(+r.spend||0),0);
  $('ov-spend').textContent=fmtM(totalSpend);
  $('ov-spend-txt').textContent=`${data.length} registros · ${new Set(data.map(r=>r.campaign_id)).size} campañas`;

  // ROAS Meta (atribución)
  const totalPV=data.reduce((a,r)=>a+(+r.purchase_value||0),0);
  const roasMeta=totalSpend>0?totalPV/totalSpend:0;
  $('ov-roas-meta').textContent=roasMeta>0?fmtR(roasMeta):'—';

  // ROAS Real (Kommo)
  const revIG=ordenes.filter(r=>r.canal_adquisicion==='INSTAGRAM').reduce((a,r)=>a+(+r.presupuesto||0),0);
  const roasReal=totalSpend>0?revIG/totalSpend:0;
  $('ov-roas-real').textContent=roasReal>0?fmtR(roasReal):'—';

  // CPL Meta
  const leadsIG=S.kommoLeadsIG.length;
  const cplMeta=leadsIG>0?totalSpend/leadsIG:0;
  $('ov-cpl-meta').textContent=cplMeta>0?fmtM2(cplMeta):'—';
  $('ov-cpl-meta-txt').textContent=`${leadsIG} leads INSTAGRAM`;

  // TikTok
  const ttSpend=tt.reduce((a,r)=>a+(+r.spend||0),0);
  $('ov-tt-spend').textContent=ttSpend>0?fmtM(ttSpend):'$0';
  $('ov-tt-txt').textContent=`${tt.length} registros manuales`;
  const leadsTT=S.kommoLeadsTT.length;
  const cplTT=leadsTT>0&&ttSpend>0?ttSpend/leadsTT:0;
  $('ov-cpl-tt').textContent=cplTT>0?fmtM2(cplTT):'—';

  // Purchases
  const totalPurch=data.reduce((a,r)=>a+(+r.purchases||0),0);
  $('ov-purchases').textContent=fmtN(totalPurch);
  $('ov-pv-txt').textContent=`purchase_value: ${fmtM(totalPV)}`;

  // Impressions
  const totalImpr=data.reduce((a,r)=>a+(+r.impressions||0),0);
  const totalClicks=data.reduce((a,r)=>a+(+r.link_clicks||0),0);
  $('ov-impr').textContent=fmtN(totalImpr);
  $('ov-clicks-txt').textContent=`${fmtN(totalClicks)} link clicks`;

  // Chart: Gasto por segmento
  const segMap={};
  data.forEach(r=>{const s=r.segment||'General';segMap[s]=(segMap[s]||0)+(+r.spend||0);});
  const segs=Object.entries(segMap).sort((a,b)=>b[1]-a[1]);
  drawDoughnut('ch-segmento',segs.map(s=>s[0]),segs.map(s=>Math.round(s[1])),PAL);

  // Chart: Gasto por país
  const paisMap={};
  data.forEach(r=>{const p=r.country||r.country_iso||'?';paisMap[p]=(paisMap[p]||0)+(+r.spend||0);});
  const paises=Object.entries(paisMap).sort((a,b)=>b[1]-a[1]).slice(0,10);
  drawBar('ch-pais',paises.map(p=>p[0]),paises.map(p=>Math.round(p[1])),PAL[1]);
}

