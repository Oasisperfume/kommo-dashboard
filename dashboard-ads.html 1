<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oasis Perfumes · Publicidad</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#080812;--surface:#0e0e1a;--surface2:#13131f;--border:rgba(255,255,255,0.07);
  --blue:#3B82F6;--indigo:#6366F1;--gold:#C9A84C;--green:#10B981;
  --violet:#A78BFA;--rose:#F472B6;--amber:#F59E0B;--red:#F87171;--cyan:#06B6D4;
  --text:#F0F0F8;--sub:rgba(240,240,248,0.55);--muted:rgba(240,240,248,0.3);
  --r:12px;--gap:14px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Montserrat',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;}

/* LOGIN */
#login-screen{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;align-items:center;justify-content:center;}
.login-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:40px;width:360px;text-align:center;}
.login-logo{font-size:22px;font-weight:900;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:6px;}
.login-sub{font-size:9px;color:var(--muted);letter-spacing:0.25em;text-transform:uppercase;margin-bottom:28px;}
.login-input{width:100%;padding:10px 14px;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Montserrat',sans-serif;font-size:12px;outline:none;margin-bottom:10px;transition:border-color 0.2s;}
.login-input:focus{border-color:var(--gold);}
.login-btn{width:100%;padding:11px;background:var(--gold);border:none;border-radius:8px;color:#000;font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:opacity 0.2s;margin-top:4px;}
.login-btn:hover{opacity:0.88;}
.login-err{color:var(--red);font-size:10px;margin-top:8px;min-height:14px;}

/* LOADER */
#loader{position:fixed;inset:0;background:var(--bg);z-index:1000;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;}
.ld-ring{width:44px;height:44px;border:3px solid var(--border);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.ld-txt{font-size:11px;color:var(--muted);font-weight:600;letter-spacing:0.1em;}

/* HEADER */
.hdr{position:sticky;top:0;z-index:100;background:rgba(8,8,18,0.97);border-bottom:1px solid var(--border);backdrop-filter:blur(12px);padding:10px 20px;}
.hdr-r1{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
.hdr-brand{display:flex;flex-direction:column;}
.hdr-name{font-size:15px;font-weight:900;letter-spacing:0.07em;text-transform:uppercase;}
.hdr-sub2{font-size:7px;color:var(--muted);letter-spacing:0.3em;text-transform:uppercase;}
.hdr-badge{font-size:8px;font-weight:700;padding:2px 8px;border-radius:100px;background:rgba(201,168,76,0.15);border:1px solid var(--gold);color:var(--gold);letter-spacing:0.1em;text-transform:uppercase;}
.sep{width:1px;height:24px;background:var(--border);}
.pill-row{display:flex;gap:4px;flex-wrap:wrap;}
.pill{padding:4px 10px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--sub);font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;cursor:pointer;transition:all 0.18s;letter-spacing:0.05em;text-transform:uppercase;}
.pill:hover{border-color:rgba(255,255,255,0.2);color:var(--text);}
.pill.on{background:var(--gold);border-color:var(--gold);color:#000;box-shadow:0 0 12px rgba(201,168,76,0.3);}
.hdr-right{margin-left:auto;display:flex;align-items:center;gap:10px;}
.btn-back{padding:5px 12px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--sub);font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;cursor:pointer;transition:all 0.18s;letter-spacing:0.05em;}
.btn-back:hover{border-color:rgba(255,255,255,0.3);color:var(--text);}
.btn-refresh-meta{padding:5px 14px;border-radius:100px;border:1px solid rgba(201,168,76,0.4);background:rgba(201,168,76,0.1);color:var(--gold);font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;cursor:pointer;transition:all 0.18s;letter-spacing:0.05em;}
.btn-refresh-meta:hover{background:rgba(201,168,76,0.2);}
.btn-refresh-meta:disabled{opacity:0.5;cursor:not-allowed;}
.dot-live{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
.sync-info{font-size:9px;color:var(--muted);font-weight:600;}

/* SUB-TABS */
.subtab-bar{display:flex;gap:4px;padding:10px 20px;border-bottom:1px solid var(--border);background:var(--surface);}
.stab{padding:5px 14px;border-radius:8px;border:none;background:transparent;color:var(--sub);font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;cursor:pointer;transition:all 0.18s;letter-spacing:0.08em;text-transform:uppercase;}
.stab:hover{color:var(--text);background:rgba(255,255,255,0.05);}
.stab.on{background:rgba(201,168,76,0.15);color:var(--gold);border:1px solid rgba(201,168,76,0.3);}

/* CONTENT */
.page{padding:16px 20px;display:flex;flex-direction:column;gap:var(--gap);}
.tab-pane{display:none;}
.tab-pane.on{display:flex;flex-direction:column;gap:var(--gap);}

/* KPI ROW */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gap);}
.kpi-row-3{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap);}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;position:relative;overflow:hidden;}
.kpi-acc{position:absolute;top:0;left:0;width:3px;height:100%;}
.kpi-lbl{font-size:8px;font-weight:700;letter-spacing:0.12em;color:var(--muted);text-transform:uppercase;margin-bottom:8px;}
.kpi-val{font-size:24px;font-weight:900;line-height:1;margin-bottom:4px;}
.kpi-txt{font-size:9px;color:var(--sub);}
.kpi-chg{font-size:10px;font-weight:700;margin-top:4px;}
.kpi-chg.up{color:var(--green);}
.kpi-chg.down{color:var(--red);}
.kpi-chg.flat{color:var(--muted);}
.kpi-note{font-size:7px;color:var(--muted);margin-top:3px;font-style:italic;}

/* CARDS */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;}
.card-hdr{display:flex;align-items:center;gap:6px;margin-bottom:12px;}
.card-title{font-size:10px;font-weight:700;color:var(--text);letter-spacing:0.05em;text-transform:uppercase;}
.card-badge{font-size:7px;font-weight:700;padding:2px 6px;border-radius:4px;margin-left:auto;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);}
canvas{width:100%!important;max-height:240px;}

/* TABLES */
.tbl-wrap{overflow-x:auto;border-radius:8px;}
table{width:100%;border-collapse:collapse;font-size:10px;}
thead th{padding:8px 10px;background:var(--surface2);color:var(--muted);font-size:8px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-align:left;white-space:nowrap;cursor:pointer;user-select:none;border-bottom:1px solid var(--border);}
thead th:hover{color:var(--text);}
tbody td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--sub);white-space:nowrap;}
tbody tr:hover td{background:rgba(255,255,255,0.03);color:var(--text);}
tbody tr:last-child td{border-bottom:none;}
.td-num{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;}
.td-name{max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);font-weight:600;}
.sort-icon{opacity:0.4;margin-left:3px;font-size:8px;}
.sort-icon.asc::after{content:'▲';}
.sort-icon.desc::after{content:'▼';}

/* CTR BADGE */
.ctr-hi{color:var(--green);font-weight:700;}
.ctr-mid{color:var(--sub);}
.ctr-lo{color:var(--red);font-weight:700;}

/* FILTER PILLS */
.filter-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.filter-lbl{font-size:8px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;}
.fpill{padding:3px 9px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--sub);font-family:'Montserrat',sans-serif;font-size:8px;font-weight:700;cursor:pointer;transition:all 0.15s;text-transform:uppercase;}
.fpill:hover{border-color:rgba(255,255,255,0.2);color:var(--text);}
.fpill.on{background:rgba(59,130,246,0.15);border-color:var(--blue);color:var(--blue);}

/* TOP CTR BARS */
.ctr-bar-row{display:flex;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid var(--border);}
.ctr-bar-row:last-child{border-bottom:none;}
.ctr-rank{font-size:9px;color:var(--muted);font-weight:700;width:18px;text-align:right;}
.ctr-name{font-size:9px;color:var(--text);font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctr-bar-wrap{width:140px;height:6px;background:rgba(255,255,255,0.07);border-radius:100px;flex-shrink:0;}
.ctr-bar-fill{height:100%;border-radius:100px;background:var(--gold);transition:width 0.5s ease;}
.ctr-pct{font-size:9px;font-weight:700;color:var(--gold);width:36px;text-align:right;}
.ctr-country{font-size:8px;color:var(--muted);width:60px;text-align:right;}

/* TIKTOK FORM */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.form-full{grid-column:1/-1;}
.form-group{display:flex;flex-direction:column;gap:4px;}
.form-lbl{font-size:8px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;}
.form-lbl span{color:var(--red);}
.form-inp{padding:8px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Montserrat',sans-serif;font-size:11px;outline:none;transition:border-color 0.2s;width:100%;}
.form-inp:focus{border-color:var(--gold);}
.form-inp::placeholder{color:var(--muted);}
.form-sel{padding:8px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Montserrat',sans-serif;font-size:11px;outline:none;width:100%;cursor:pointer;}
.form-sel option{background:var(--surface);}
.form-textarea{padding:8px 12px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Montserrat',sans-serif;font-size:11px;outline:none;resize:vertical;width:100%;min-height:70px;}
.form-textarea:focus{border-color:var(--gold);}
.btn-save{padding:10px 24px;background:var(--gold);border:none;border-radius:8px;color:#000;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;cursor:pointer;transition:opacity 0.2s;letter-spacing:0.05em;}
.btn-save:hover{opacity:0.88;}
.btn-save:disabled{opacity:0.5;cursor:not-allowed;}
.toast{position:fixed;bottom:24px;right:24px;padding:10px 18px;border-radius:10px;font-size:11px;font-weight:700;z-index:9999;opacity:0;transition:opacity 0.3s;pointer-events:none;}
.toast.ok{background:rgba(16,185,129,0.15);border:1px solid var(--green);color:var(--green);}
.toast.err{background:rgba(248,113,113,0.15);border:1px solid var(--red);color:var(--red);}
.toast.show{opacity:1;}

/* CONVERSION TABLE */
.conv-row-total{background:rgba(201,168,76,0.07)!important;}
.conv-row-total td{color:var(--gold)!important;font-weight:700!important;}

/* EMPTY STATE */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:60px 20px;color:var(--muted);}
.empty-icon{font-size:36px;opacity:0.4;}
.empty-txt{font-size:11px;font-weight:600;letter-spacing:0.05em;}

/* ROAS NOTE */
.roas-note{font-size:8px;color:var(--muted);background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:6px;padding:6px 10px;line-height:1.5;}

/* SECTION DIVIDER */
.sec-lbl{font-size:8px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.15em;padding:4px 0;}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">Oasis Perfumes</div>
    <div class="login-sub">Rendimiento Publicitario</div>
    <input class="login-input" id="lu" type="text" placeholder="Usuario" autocomplete="username">
    <input class="login-input" id="lp" type="password" placeholder="Contraseña" autocomplete="current-password">
    <button class="login-btn" onclick="doLogin()">Ingresar</button>
    <div class="login-err" id="lerr"></div>
  </div>
</div>

<!-- LOADER -->
<div id="loader">
  <div class="ld-ring"></div>
  <div class="ld-txt">CARGANDO DATOS</div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- APP -->
<div id="app" style="display:none;">

  <!-- HEADER -->
  <div class="hdr">
    <div class="hdr-r1">
      <div class="hdr-brand">
        <div class="hdr-name">Oasis Perfumes</div>
        <div class="hdr-sub2">CRM Analytics</div>
      </div>
      <span class="hdr-badge">📊 Publicidad</span>
      <div class="sep"></div>
      <div class="pill-row" id="period-pills">
        <button class="pill on" data-p="30d">30D</button>
        <button class="pill" data-p="7d">7D</button>
        <button class="pill" data-p="90d">90D</button>
      </div>
      <div class="hdr-right">
        <button class="btn-refresh-meta" id="btn-refresh-meta">🔄 Sync Meta</button>
        <div class="sep"></div>
        <div class="dot-live"></div>
        <span class="sync-info" id="sync-txt">—</span>
        <div class="sep"></div>
        <button class="btn-back" onclick="window.location.href='/'">← CRM</button>
      </div>
    </div>
  </div>

  <!-- SUB-TABS -->
  <div class="subtab-bar">
    <button class="stab on" data-tab="overview">📈 Overview</button>
    <button class="stab" data-tab="campanas">🎯 Campañas</button>
    <button class="stab" data-tab="conversion">💰 Conversión</button>
    <button class="stab" data-tab="topctr">🏆 Top CTR</button>
    <button class="stab" data-tab="tiktok">📱 TikTok Manual</button>
  </div>

  <!-- CONTENT -->
  <div class="page">

    <!-- ══════════════════════════════════
         TAB: OVERVIEW
    ══════════════════════════════════ -->
    <div class="tab-pane on" id="tab-overview">

      <!-- KPI row 1: Meta -->
      <div class="sec-lbl">Meta Ads</div>
      <div class="kpi-row">
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--gold)"></div>
          <div class="kpi-lbl">Gasto Total Meta</div>
          <div class="kpi-val" id="ov-spend" style="color:var(--gold)">—</div>
          <div class="kpi-txt" id="ov-spend-txt">últimos 30 días</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--green)"></div>
          <div class="kpi-lbl">ROAS Real (Kommo)</div>
          <div class="kpi-val" id="ov-roas-real" style="color:var(--green)">—</div>
          <div class="kpi-txt">Revenue Kommo INSTAGRAM ÷ Gasto</div>
          <div class="kpi-note">⚠️ Solo leads con canal = INSTAGRAM</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--blue)"></div>
          <div class="kpi-lbl">ROAS Meta (atribución)</div>
          <div class="kpi-val" id="ov-roas-meta" style="color:var(--blue)">—</div>
          <div class="kpi-txt">purchase_value ÷ spend (ventana 7d clic)</div>
          <div class="kpi-note">⚠️ Siempre mayor al ROAS Real</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--violet)"></div>
          <div class="kpi-lbl">Costo / Lead Meta</div>
          <div class="kpi-val" id="ov-cpl-meta" style="color:var(--violet)">—</div>
          <div class="kpi-txt" id="ov-cpl-meta-txt">leads con canal INSTAGRAM</div>
        </div>
      </div>

      <!-- KPI row 2: TikTok + Purchases -->
      <div class="kpi-row">
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--cyan)"></div>
          <div class="kpi-lbl">Gasto Total TikTok</div>
          <div class="kpi-val" id="ov-tt-spend" style="color:var(--cyan)">—</div>
          <div class="kpi-txt" id="ov-tt-txt">registros manuales</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--cyan)"></div>
          <div class="kpi-lbl">Costo / Lead TikTok</div>
          <div class="kpi-val" id="ov-cpl-tt" style="color:var(--cyan)">—</div>
          <div class="kpi-txt">leads con canal TIKTOK</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--rose)"></div>
          <div class="kpi-lbl">Compras Meta (px)</div>
          <div class="kpi-val" id="ov-purchases" style="color:var(--rose)">—</div>
          <div class="kpi-txt" id="ov-pv-txt">— purchase_value</div>
        </div>
        <div class="kpi">
          <div class="kpi-acc" style="background:var(--amber)"></div>
          <div class="kpi-lbl">Impresiones Totales</div>
          <div class="kpi-val" id="ov-impr" style="color:var(--amber)">—</div>
          <div class="kpi-txt" id="ov-clicks-txt">— clicks</div>
        </div>
      </div>

      <!-- Charts row -->
      <div class="g2">
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">💰 Gasto por Segmento</span>
            <span class="card-badge" style="background:rgba(201,168,76,0.1);color:var(--gold)">META</span>
          </div>
          <canvas id="ch-segmento" style="max-height:220px;"></canvas>
        </div>
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">🌍 Gasto por País</span>
            <span class="card-badge" style="background:rgba(59,130,246,0.1);color:var(--blue)">META</span>
          </div>
          <canvas id="ch-pais" style="max-height:220px;"></canvas>
        </div>
      </div>

      <!-- ROAS note -->
      <div class="roas-note">
        ℹ️ <strong>ROAS Real vs ROAS Meta:</strong> El ROAS Real usa las ventas registradas en Kommo con canal_adquisicion = INSTAGRAM — más conservador y confiable. El ROAS Meta usa la atribución propia de Meta (ventana 7 días clic / 1 día vista), siempre más alto. Mostrar ambos para entender la brecha de atribución.
      </div>
    </div>

    <!-- ══════════════════════════════════
         TAB: CAMPAÑAS
    ══════════════════════════════════ -->
    <div class="tab-pane" id="tab-campanas">

      <div class="filter-row" id="camp-filters">
        <span class="filter-lbl">Segmento:</span>
        <button class="fpill on" data-seg="">Todos</button>
        <button class="fpill" data-seg="Wholesale">Wholesale</button>
        <button class="fpill" data-seg="Wholesale RT">Wholesale RT</button>
        <button class="fpill" data-seg="Wholesale Exclu">Wholesale Exclu</button>
        <button class="fpill" data-seg="Instagram Perfil">Instagram Perfil</button>
        <button class="fpill" data-seg="Ventas Web">Ventas Web</button>
        <span class="filter-lbl" style="margin-left:8px;">País:</span>
        <div id="pais-pills" style="display:flex;gap:4px;flex-wrap:wrap;"></div>
      </div>

      <div class="card" style="padding:0;">
        <div class="tbl-wrap">
          <table id="tbl-campanas">
            <thead>
              <tr>
                <th>Campaña</th>
                <th>Seg.</th>
                <th>País</th>
                <th class="td-num" data-sort="spend">Gasto ↕</th>
                <th class="td-num" data-sort="impressions">Impr. ↕</th>
                <th class="td-num" data-sort="link_clicks">Clicks ↕</th>
                <th class="td-num" data-sort="ctr">CTR ↕</th>
                <th class="td-num" data-sort="cpm">CPM ↕</th>
                <th class="td-num" data-sort="cpc">CPC ↕</th>
                <th class="td-num" data-sort="reach">Alcance ↕</th>
                <th class="td-num" data-sort="frequency">Frec. ↕</th>
                <th class="td-num" data-sort="purchases">Compras ↕</th>
              </tr>
            </thead>
            <tbody id="tbody-campanas"></tbody>
          </table>
        </div>
      </div>
      <div class="sync-info" id="camp-count" style="text-align:right;padding-top:4px;">—</div>
    </div>

    <!-- ══════════════════════════════════
         TAB: CONVERSIÓN
    ══════════════════════════════════ -->
    <div class="tab-pane" id="tab-conversion">
      <div class="card" style="padding:0;">
        <div class="tbl-wrap">
          <table id="tbl-conv">
            <thead>
              <tr>
                <th>Canal</th>
                <th class="td-num">Inversión</th>
