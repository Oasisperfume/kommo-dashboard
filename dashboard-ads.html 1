// SUPABASE FETCH
// ═══════════════════════════════════════════════════════════════
async function sbGet(path){
  const r=await fetch(`${SB_URL}/rest/v1/${path}`,{
    headers:{'apikey':SB_KEY,'Authorization':`Bearer ${SB_KEY}`,'Accept':'application/json'}
  });
  if(!r.ok)throw new Error(`SB error ${r.status}`);
  return r.json();
}

async function sbPost(table, body){
  const r=await fetch(`${SB_URL}/rest/v1/${table}`,{
    method:'POST',
    headers:{'apikey':SB_KEY,'Authorization':`Bearer ${SB_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'},
    body:JSON.stringify(body)
  });
  if(!r.ok){const t=await r.text();throw new Error(t);}
}

// ═══════════════════════════════════════════════════════════════
// DATE RANGE
// ═══════════════════════════════════════════════════════════════
function getPeriodDates(p){
  const now=new Date();
  const to=now.toISOString().split('T')[0];
  let from;
  if(p==='7d'){const d=new Date(now);d.setDate(d.getDate()-7);from=d.toISOString().split('T')[0];}
  else if(p==='30d'){const d=new Date(now);d.setDate(d.getDate()-30);from=d.toISOString().split('T')[0];}
  else if(p==='90d'){const d=new Date(now);d.setDate(d.getDate()-90);from=d.toISOString().split('T')[0];}
  return{from,to};
}

