function renderCampanasTable(){
  let rows=S.metaData.filter(r=>{
    if(S.campSeg&&r.segment!==S.campSeg)return false;
    if(S.campPais&&(r.country||r.country_iso)!==S.campPais)return false;
    return true;
  });
  // Sort
  const{col,dir}=S.campSort;
  rows.sort((a,b)=>{
    const av=+a[col]||0,bv=+b[col]||0;
    return dir==='desc'?bv-av:av-bv;
  });
  const tbody=$('tbody-campanas');
  if(!rows.length){tbody.innerHTML=`<tr><td colspan="12" style="text-align:center;padding:30px;color:var(--muted);">Sin datos para los filtros seleccionados</td></tr>`;return;}
  tbody.innerHTML=rows.map(r=>{
    const ctr=+r.ctr||0;
    const ctrClass=ctr>=6?'ctr-hi':ctr>=3?'ctr-mid':'ctr-lo';
    return`<tr>
      <td class="td-name" title="${r.campaign_name}">${r.campaign_name}</td>
      <td style="color:var(--muted);font-size:9px;">${r.segment||'—'}</td>
      <td>${r.country||r.country_iso||'—'}</td>
      <td class="td-num" style="color:var(--gold);">${fmtM2(r.spend)}</td>
      <td class="td-num">${fmtN(r.impressions)}</td>
      <td class="td-num">${fmtN(r.link_clicks)}</td>
      <td class="td-num ${ctrClass}">${fmtPct(r.ctr)}</td>
      <td class="td-num">${fmtM2(r.cpm)}</td>
      <td class="td-num">${r.cpc?'$'+(+r.cpc).toFixed(4):'—'}</td>
      <td class="td-num">${fmtN(r.reach)}</td>
      <td class="td-num">${r.frequency?(+r.frequency).toFixed(1)+'x':'—'}</td>
      <td class="td-num" style="color:${(+r.purchases||0)>0?'var(--rose)':'var(--muted)'};">${r.purchases||0}</td>
    </tr>`;
  }).join('');
  $('camp-count').textContent=`${rows.length} registros · Ordenado por ${col} ${dir==='desc'?'↓':'↑'}`;
}

// ═══════════════════════════════════════════════════════════════
// CONVERSIÓN
// ═══════════════════════════════════════════════════════════════
function renderConversion(){
  const data=S.metaData;
  const tt=S.tiktokData;
  const ords=S.kommoOrdenes;

  const metaSpend=data.reduce((a,r)=>a+(+r.spend||0),0);
  const ttSpend=tt.reduce((a,r)=>a+(+r.spend||0),0);

  const leadsIG=S.kommoLeadsIG.length;
  const leadsTT=S.kommoLeadsTT.length;

  const ordsIG=ords.filter(r=>r.canal_adquisicion==='INSTAGRAM');
  const ordsTT=ords.filter(r=>r.canal_adquisicion==='TIKTOK');
  const ordsWEB=ords.filter(r=>r.canal_adquisicion==='WEBSITE'||r.canal_adquisicion==='WEB');
  const ordsNULL=ords.filter(r=>!r.canal_adquisicion);

  const revIG=ordsIG.reduce((a,r)=>a+(+r.presupuesto||0),0);
  const revTT=ordsTT.reduce((a,r)=>a+(+r.presupuesto||0),0);
  const revWEB=ordsWEB.reduce((a,r)=>a+(+r.presupuesto||0),0);
  const revNULL=ordsNULL.reduce((a,r)=>a+(+r.presupuesto||0),0);
  const totalRev=ords.reduce((a,r)=>a+(+r.presupuesto||0),0);
  const totalLeads=leadsIG+leadsTT;
  const totalSpend=metaSpend+ttSpend;

  const mkRow=(canal,inv,leads,nOrds,rev,note='')=>{
    const cpl=leads>0&&inv>0?inv/leads:null;
    const cpc=nOrds>0&&inv>0?inv/nOrds:null;
    const roas=rev>0&&inv>0?rev/inv:null;
    return`<tr${note?' class="conv-row-total"':''}>
      <td style="font-weight:700;color:var(--text);">${canal}</td>
      <td class="td-num" style="color:var(--gold);">${inv>0?fmtM(inv):'—'}</td>
      <td class="td-num">${leads>0?leads:'—'}</td>
      <td class="td-num">${nOrds>0?nOrds:'—'}</td>
      <td class="td-num" style="color:var(--green);">${rev>0?fmtM(rev):'—'}</td>
      <td class="td-num">${cpl?fmtM2(cpl):'—'}</td>
      <td class="td-num">${cpc?fmtM2(cpc):'—'}</td>
      <td class="td-num" style="color:${roas&&roas>=1?'var(--green)':'var(--red)'};">${roas?fmtR(roas):'—'}</td>
    </tr>`;
  };

  $('tbody-conv').innerHTML=
    mkRow('📘 Meta (Instagram)',metaSpend,leadsIG,ordsIG.length,revIG)+
    mkRow('📱 TikTok',ttSpend,leadsTT,ordsTT.length,revTT)+
    mkRow('🌐 Website / Orgánico',0,0,ordsWEB.length,revWEB)+
    mkRow('❓ Sin canal / Mayorista',0,0,ordsNULL.length,revNULL)+
    mkRow('📊 TOTAL',totalSpend,totalLeads,ords.length,totalRev,true);
}

